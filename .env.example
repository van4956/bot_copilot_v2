BOT_TOKEN=<bot_token>
BOT_TOKEN_TEST=<test_bot_token>
OWNER=<user_id>
ADMIN_LIST=<user_id>,<user_id>
HOME_GROUP=<chat_id>
WORK_GROUP=<chat_id>,<chat_id>

PAYMASTER_PROVIDER_TOKEN=<provider_token>
API_WEATHER=<api_key>
API_CURRENCY=<api_key>
API_GPT=<api_key>

DB_LITE=sqlite+aiosqlite:///database/sqlite.db
DB_POST=postgresql+asyncpg://bot_app:<app_password>@db:5432/bot_db
POSTGRES_DB=bot_db
