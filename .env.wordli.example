# Образец без секретов. Рабочий файл .env.wordli.local не коммитить.
APP_ENV=production
WORDLI_PUBLIC_ORIGIN=https://copilot-games-v4956.duckdns.org
WORDLI_BOT_TOKEN=REPLACE_WITH_PRODUCTION_BOT_TOKEN
WORDLI_EXPECTED_BOT_ID=REPLACE_WITH_PRODUCTION_BOT_ID
WORDLI_DATABASE_URL=postgresql+asyncpg://copilot_wordli:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/REPLACE_WITH_COPILOT_DATABASE

# Сначала только проверяющие аккаунты; all открывается отдельным решением.
WORDLI_ACCESS=restricted
WORDLI_ALLOWED_USER_IDS=REPLACE_WITH_OWNER_ID

# Отдельный добровольный сервис напоминаний; до согласованного запуска выключен.
WORDLI_REMINDERS_ENABLED=false

# Нужен только оператору миграции, не контейнеру приложения.
# WORDLI_MIGRATION_DATABASE_URL=postgresql+asyncpg://migration_operator:SECRET@db:5432/COPILOT_DATABASE
